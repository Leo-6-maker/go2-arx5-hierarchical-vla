    "event_mask": {"shape": ["B", "N"], "dtype": "bool", "meaning": "true for populated causal event slots"},
    "section_mask": {"shape": ["B", "N", 4], "dtype": "bool", "section_order": ["task_demo_context", "interaction_history", "failure_outcome_context", "local_dynamics_context"]},
    "missingness_mask": {"shape": ["B", "N", "F"], "dtype": "bool", "meaning": "true only when an explicitly nullable resolved payload is absent"},
    "temporal_order": "event_time ascending, then available_time ascending, then model-visible payload identity; query_time is an inclusive cutoff",
    "padding": "masked zero padding only after causal filtering; no semantic zero imputation"
  },
  "physical_semantics": {
    "frame": "source-declared frame tag is required; no implicit frame conversion",
    "units": "source-declared units, SI where the immutable source contract declares SI; no guessed conversion",
    "normalization": "identity must be explicitly supplied by a future PI-selected adapter; no Stage45E stats are implicitly reused",
    "command_vs_response": "commanded payload and executed/observed response payload remain distinct",
    "local_dynamics_closed_transition": "event_time + dt <= available_time <= query_time; state_before/state_after/delta and dt are required before a transition can be visible"
  },
  "structured_action_abi": {"schema": "StructuredActionV1", "shape": [40, 132], "active_scalars": 190, "decoder_semantics": "unchanged"},
  "execution_boundary": {"tensor_materialization": 0, "model_forward": 0, "training": 0, "gpu": 0, "pbs": 0, "Validation-E": 0, "Holdout-F": 0, "simulator": 0, "WBC": 0, "hardware": 0, "winner_selection": 0}
