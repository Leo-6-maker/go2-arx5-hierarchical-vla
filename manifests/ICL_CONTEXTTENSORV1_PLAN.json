  "tensor_layout": {
    "schema": "ContextTensorV1",
    "status": "PLAN_ONLY",
    "batch_symbol": "B",
    "event_slots": {"shape": ["B", "N", "F"], "dtype": "float32", "N": "PI-selected bounded slots; section-major, causal-time order", "F": "fixed field vector defined by the selected future adapter"},
