      "missing_executed_response_representation": "null; never inferred"
    },
    "failure_outcome_context": {
      "purpose": "historical failed attempt and observed outcome before a retry query",
        "fields": ["attempt_id", "failure_observation_digest", "outcome_label", "observed_recovery_digest", "event_time", "available_time"],
        "availability_rule": "event_time <= available_time <= query_time; null recovery does not invent an earlier time",
      "future_corrective_action_allowed": false
    },
    "local_dynamics_context": {
      "purpose": "observed local command-response transitions",
        "fields": ["event_time", "available_time", "state_before_digest", "commanded_action_digest", "executed_or_observed_response_digest", "state_after_digest", "delta_state_digest", "dt"],
        "availability_rule": "event_time <= available_time <= query_time; complete transition/state_after is closed by available_time",
      "physical_trace_required": true,
      "missing_response_representation": "null; no fabricated dynamics"
    }
  },
