#!/bin/bash
# Stage45B: one authorized FRESH_BASE -> FULL24 2000-step H200 exposure.
# The PBS envelope receives immutable gitless GR00T and native FFmpeg snapshots
# before any Stage45B Python import.
# This template never submits a replacement, resumes, runs evaluation, reads
# Validation-E/Holdout-F, or invokes WBC/simulator/hardware.

#PBS -N st45b_full24
#PBS -P CFP03-CF-004
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

: "${STAGE45B_REPO:?Set the clean Stage45B checkout}"
: "${STAGE45B_BUNDLE:?Set the immutable B1 execution manifest}"
: "${STAGE45B_OUTPUT_ROOT:?Set a new project-scratch output root}"
: "${STAGE45B_BASE_MODEL_PATH:?Set exact BASE tree}"
: "${STAGE45B_DATASET_DIR:?Set exact FULL24 TRAIN tree}"
: "${STAGE45B_GROOT_SNAPSHOT_ARCHIVE:?Set sealed GR00T snapshot archive}"
: "${STAGE45B_GROOT_SNAPSHOT_MANIFEST:?Set sealed GR00T snapshot manifest}"
: "${STAGE45B_GROOT_SNAPSHOT_ARCHIVE_SHA256:?Set sealed GR00T archive SHA256}"
: "${STAGE45B_GROOT_SNAPSHOT_MANIFEST_FILE_SHA256:?Set sealed GR00T manifest file SHA256}"
: "${STAGE45B_GROOT_SNAPSHOT_MANIFEST_PAYLOAD_SHA256:?Set sealed GR00T manifest payload SHA256}"
: "${STAGE45B_GROOT_SNAPSHOT_PAYLOAD_TREE_SHA256:?Set sealed GR00T payload tree SHA256}"
: "${STAGE45B_COSMOS_ROOT:?Set exact Cosmos cache root}"
: "${STAGE45B_MODALITY_CONFIG:?Set exact modality module}"
: "${STAGE45B_CONFIG_PATH:?Set frozen Stage38 config.yaml}"
: "${STAGE45B_STATS_ARTIFACT:?Set exact B0 statistics JSON}"
: "${STAGE45B_PYTHON:?Set exact Stage45B runtime Python}"
: "${STAGE45B_PRODUCTION_RELEASE:?Set immutable Stage45B B2 production release}"
: "${STAGE45B_PRODUCTION_RELEASE_SHA256:?Set production release SHA256}"
: "${STAGE45B_VIDEO_RUNTIME_QUALIFICATION:?Set immutable login-plane video runtime qualification}"
: "${STAGE45B_VIDEO_RUNTIME_QUALIFICATION_SHA256:?Set video runtime qualification SHA256}"
: "${STAGE45B_FFMPEG_RUNTIME_ROOT:?Set immutable sealed FFmpeg runtime root}"
: "${STAGE45B_FFMPEG_RUNTIME_ID:?Set sealed FFmpeg runtime artifact ID}"
: "${STAGE45B_FFMPEG_RUNTIME_MANIFEST_SHA256:?Set sealed FFmpeg runtime manifest SHA256}"
: "${STAGE45B_TORCHCODEC_PACKAGE_ROOT:?Set exact TorchCodec package root}"
: "${STAGE45B_TORCH_LIBRARY_ROOT:?Set exact Torch library root}"
: "${STAGE45B_RUNTIME_DATASET_QUALIFICATION:?Set existing 24/24 runtime-dataset qualification}"
: "${PBS_JOBID:?PBS_JOBID must be available}"
: "${STAGE45B_PYTHON_REALPATH:?Set expected Stage45B Python realpath}"
: "${STAGE45B_EXECUTION_HEAD:?Set exact execution HEAD}"

test -f "${STAGE45B_VIDEO_RUNTIME_QUALIFICATION}"
test "$(sha256sum "${STAGE45B_VIDEO_RUNTIME_QUALIFICATION}" | awk '{print $1}')" = "${STAGE45B_VIDEO_RUNTIME_QUALIFICATION_SHA256}"
test -d "${STAGE45B_FFMPEG_RUNTIME_ROOT}/lib"
test -d "${STAGE45B_FFMPEG_RUNTIME_ROOT}/compat"
test "$(basename "${STAGE45B_FFMPEG_RUNTIME_ROOT}")" = "STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__${STAGE45B_FFMPEG_RUNTIME_ID}"
test "$(sha256sum "${STAGE45B_FFMPEG_RUNTIME_ROOT}/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1.json" | awk '{print $1}')" = "${STAGE45B_FFMPEG_RUNTIME_MANIFEST_SHA256}"
STAGE45B_AMBIENT_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="${STAGE45B_FFMPEG_RUNTIME_ROOT}/lib:${STAGE45B_FFMPEG_RUNTIME_ROOT}/compat:${STAGE45B_TORCHCODEC_PACKAGE_ROOT}:${STAGE45B_TORCH_LIBRARY_ROOT}:${STAGE45B_AMBIENT_LD_LIBRARY_PATH}"

cd "${STAGE45B_REPO}"
test "$(git branch --show-current)" = "stage45b/full24-fresh-base-execution"
test "$(git rev-parse HEAD)" = "${STAGE45B_EXECUTION_HEAD}"
test -z "$(git status --porcelain=v1)"

OUTPUT_PARENT="$(dirname "${STAGE45B_OUTPUT_ROOT}")"
test -d "${OUTPUT_PARENT}"
test ! -e "${STAGE45B_OUTPUT_ROOT}"
BOOTSTRAP_TMPDIR="${OUTPUT_PARENT}/.stage45b-pbs-tmp-${PBS_JOBID}"
test ! -e "${BOOTSTRAP_TMPDIR}"
mkdir -p "${BOOTSTRAP_TMPDIR}"
PY_PREFLIGHT_PATH="${BOOTSTRAP_TMPDIR}/stage45b_python_runtime_preflight.json"
GROOT_SNAPSHOT_EVIDENCE_PATH="${BOOTSTRAP_TMPDIR}/groot_snapshot_verification.json"
RELEASE_EVIDENCE_PATH="${BOOTSTRAP_TMPDIR}/stage45b_production_release_verification.json"
VIDEO_RUNTIME_COMPUTE_EVIDENCE_PATH="${BOOTSTRAP_TMPDIR}/stage45b_video_runtime_compute_qualification.json"
VIDEO_RUNTIME_QUALIFICATION_ROOT="${BOOTSTRAP_TMPDIR}/stage45b_video_runtime_qualification"
GROOT_RUNTIME_ROOT="${BOOTSTRAP_TMPDIR}/groot-source"
test -x "${STAGE45B_PYTHON}"
test "$(readlink -f "${STAGE45B_PYTHON}")" = "${STAGE45B_PYTHON_REALPATH}"

GPU_COUNT="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l)"
GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^[[:space:]]*$/d' | head -n 1 | sed 's/[[:space:]]*$//')"
test "${GPU_COUNT}" -eq 1
case "${GPU_NAME}" in *H200*) ;; *) echo "FAIL_CLOSED: expected H200, observed ${GPU_NAME}" >&2; exit 2 ;; esac

export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export STAGE45B_LABEL_ANCHOR_RECONCILIATION=1
unset PYTHONPATH 2>/dev/null || true
export TMPDIR="${BOOTSTRAP_TMPDIR}"
export TMP="${TMPDIR}" TEMP="${TMPDIR}"
mkdir -p "${TMPDIR}"

"${STAGE45B_PYTHON}" "${STAGE45B_REPO}/scripts/stage45b_production_release.py" \
  --mode verify \
  --repo "${STAGE45B_REPO}" \
  --release "${STAGE45B_PRODUCTION_RELEASE}" \
  --expected-head "${STAGE45B_EXECUTION_HEAD}" \
  --expected-release-sha256 "${STAGE45B_PRODUCTION_RELEASE_SHA256}" \
  --bundle "${STAGE45B_BUNDLE}" \
  --evidence-path "${RELEASE_EVIDENCE_PATH}"

"${STAGE45B_PYTHON}" "${STAGE45B_REPO}/scripts/stage45b_groot_source_snapshot.py" \
  --mode extract \
  --archive "${STAGE45B_GROOT_SNAPSHOT_ARCHIVE}" \
  --manifest "${STAGE45B_GROOT_SNAPSHOT_MANIFEST}" \
  --destination "${GROOT_RUNTIME_ROOT}" \
  --json-output "${GROOT_SNAPSHOT_EVIDENCE_PATH}" \
  --expected-archive-sha256 "${STAGE45B_GROOT_SNAPSHOT_ARCHIVE_SHA256}" \
  --expected-manifest-file-sha256 "${STAGE45B_GROOT_SNAPSHOT_MANIFEST_FILE_SHA256}" \
  --expected-manifest-payload-sha256 "${STAGE45B_GROOT_SNAPSHOT_MANIFEST_PAYLOAD_SHA256}" \
  --expected-payload-tree-sha256 "${STAGE45B_GROOT_SNAPSHOT_PAYLOAD_TREE_SHA256}"

"${STAGE45B_PYTHON}" "${STAGE45B_REPO}/scripts/stage45b_video_decoder_runtime.py" \
  --repo "${STAGE45B_REPO}" \
  --expected-head "${STAGE45B_EXECUTION_HEAD}" \
  --requested-python "${STAGE45B_PYTHON}" \
  --torchcodec-package-root "${STAGE45B_TORCHCODEC_PACKAGE_ROOT}" \
  --base "${STAGE45B_BASE_MODEL_PATH}" \
  --dataset "${STAGE45B_DATASET_DIR}" \
  --groot-source "${GROOT_RUNTIME_ROOT}" \
  --groot-manifest "${STAGE45B_GROOT_SNAPSHOT_MANIFEST}" \
  --groot-manifest-sha256 "${STAGE45B_GROOT_SNAPSHOT_MANIFEST_FILE_SHA256}" \
  --groot-manifest-payload-sha256 "${STAGE45B_GROOT_SNAPSHOT_MANIFEST_PAYLOAD_SHA256}" \
  --groot-payload-tree-sha256 "${STAGE45B_GROOT_SNAPSHOT_PAYLOAD_TREE_SHA256}" \
  --cosmos "${STAGE45B_COSMOS_ROOT}" \
  --modality "${STAGE45B_MODALITY_CONFIG}" \
  --config "${STAGE45B_CONFIG_PATH}" \
  --stats "${STAGE45B_STATS_ARTIFACT}" \
  --dataset-qualification "${STAGE45B_RUNTIME_DATASET_QUALIFICATION}" \
  --ffmpeg-runtime-root "${STAGE45B_FFMPEG_RUNTIME_ROOT}" \
  --expected-ffmpeg-runtime-id "${STAGE45B_FFMPEG_RUNTIME_ID}" \
  --qualification-root "${VIDEO_RUNTIME_QUALIFICATION_ROOT}" \
  --evidence "${VIDEO_RUNTIME_COMPUTE_EVIDENCE_PATH}"

"${STAGE45B_PYTHON}" "${STAGE45B_REPO}/scripts/stage45b_premodel_runtime_smoke.py" \
  --mode scientific \
  --evidence-path "${PY_PREFLIGHT_PATH}" \
  --repo "${STAGE45B_REPO}" \
  --expected-head "${STAGE45B_EXECUTION_HEAD}" \
  --bundle "${STAGE45B_BUNDLE}" \
  --base-model-path "${STAGE45B_BASE_MODEL_PATH}" \
  --dataset-dir "${STAGE45B_DATASET_DIR}" \
  --groot-source "${GROOT_RUNTIME_ROOT}" \
  --cosmos-root "${STAGE45B_COSMOS_ROOT}" \
  --modality-config "${STAGE45B_MODALITY_CONFIG}" \
  --config-path "${STAGE45B_CONFIG_PATH}" \
  --stats-artifact "${STAGE45B_STATS_ARTIFACT}" \
  --requested-python "${STAGE45B_PYTHON}" \
  --scientific-output-root "${STAGE45B_OUTPUT_ROOT}"

copy_stage45b_python_preflight() {
  if [ -f "${PY_PREFLIGHT_PATH}" ] && [ -d "${STAGE45B_OUTPUT_ROOT}" ]; then
    cp "${PY_PREFLIGHT_PATH}" "${STAGE45B_OUTPUT_ROOT}/stage45b_python_runtime_preflight.json" || true
  fi
  if [ -f "${GROOT_SNAPSHOT_EVIDENCE_PATH}" ] && [ -d "${STAGE45B_OUTPUT_ROOT}" ]; then
    cp "${GROOT_SNAPSHOT_EVIDENCE_PATH}" "${STAGE45B_OUTPUT_ROOT}/groot_snapshot_verification.json" || true
  fi
  if [ -f "${RELEASE_EVIDENCE_PATH}" ] && [ -d "${STAGE45B_OUTPUT_ROOT}" ]; then
    cp "${RELEASE_EVIDENCE_PATH}" "${STAGE45B_OUTPUT_ROOT}/stage45b_production_release_verification.json" || true
  fi
  if [ -f "${VIDEO_RUNTIME_COMPUTE_EVIDENCE_PATH}" ] && [ -d "${STAGE45B_OUTPUT_ROOT}" ]; then
    cp "${VIDEO_RUNTIME_COMPUTE_EVIDENCE_PATH}" "${STAGE45B_OUTPUT_ROOT}/stage45b_video_runtime_compute_qualification.json" || true
  fi
}
trap copy_stage45b_python_preflight EXIT

"${STAGE45B_PYTHON}" scripts/stage45b_full24_fresh_base_train.py \
  --bundle "${STAGE45B_BUNDLE}" \
  --output-root "${STAGE45B_OUTPUT_ROOT}" \
  --base-model-path "${STAGE45B_BASE_MODEL_PATH}" \
  --dataset-dir "${STAGE45B_DATASET_DIR}" \
  --groot-source "${GROOT_RUNTIME_ROOT}" \
  --cosmos-root "${STAGE45B_COSMOS_ROOT}" \
  --modality-config "${STAGE45B_MODALITY_CONFIG}" \
  --config-path "${STAGE45B_CONFIG_PATH}" \
  --stats-artifact "${STAGE45B_STATS_ARTIFACT}" \
  --release "${STAGE45B_PRODUCTION_RELEASE}" \
  --expected-release-sha256 "${STAGE45B_PRODUCTION_RELEASE_SHA256}"

echo "HOPPER_STAGE45B_FULL24_FRESH_BASE_TRAINING_COMPLETE"
echo "NEXT_GATE=GPT_PI_REVIEW_AFTER_STAGE45B_B2_PI0087_RETURN"
