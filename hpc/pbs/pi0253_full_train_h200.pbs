#!/usr/bin/env bash
#PBS -N pi0253_full_g
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -m n
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=16:00:00
#PBS -o /scratch/e1192548/Projects/go2-arx5/experiments/PI0253/logs/
#PBS -e /scratch/e1192548/Projects/go2-arx5/experiments/PI0253/logs/
set -euo pipefail
card=${PI0253_RUN_CARD:?sealed FULL run card required}
expected=${PI0253_RUN_CARD_SHA256:?run-card hash required}
resume=${PI0253_RESUME_AFTER_STEP:-0}
case "$resume" in 0|2500|5000|7500) ;; *) exit 2 ;; esac
test "$(sha256sum "$card" | cut -d ' ' -f 1)" = "$expected"
test "$(jq -er .sha256 "$(dirname "$card")/run_card.seal.json")" = "$expected"
test "$(jq -er .schema "$card")" = PI0253_FULL_RUN_CARD_V1
test "$(jq -er .authorization "$card")" = PI0253_LIVE_BRIDGE_TO_FULL_SUPPORT_GO
test "$(jq -er .selected_checkpoint "$card")" = NONE
test "$(jq -er .stage.steps "$card")" = 10000
test "$(jq -er .d1_runtime_id "$card")" = S4
output=$(jq -er .paths.output_root "$card")
stage10=$(jq -er .paths.stage10_root "$card")
driver=$(jq -er .paths.execution_driver_root "$card")
legacy=$(jq -er .paths.legacy_execution_driver_root "$card")
repo_code=$(jq -er .paths.repo_code_root "$card")
code=$(jq -er .paths.code_root "$card")
runtime=$(jq -er .paths.training_runtime_root "$card")
groot=$(jq -er .paths.groot_source "$card")
token=$(jq -er .archive.token_file "$card")
venv="$stage10/runtime/venv"
ff=/scratch/e1192548/Projects/go2-arx5/archive/stage_runs/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__9243a7880b06ac3984ddf4a1a667b685441ec0f34d6d529fa0f96c3c894e10cf
test -x "$venv/bin/python" && test -d "$ff/lib"
test "$(jq -er .run_card_sha256 "$output/hf_preflight_receipt.json")" = "$expected"
test "$(jq -er .status "$(dirname "$output")/evidence/FULL_ENTRY_CPU_CHECK.json")" = PASS
test "$(jq -er .status "$(dirname "$output")/evidence/full_admission.json")" = PASS_FULL_ADMISSION
test "$(jq -er .run_card_sha256 "$(dirname "$output")/evidence/full_admission.json")" = "$expected"
unset PI0243_DURABLE_ROOT PI0243_DURABLE_HOST PI0243_CHECKPOINT_FAMILY
export PI0243_HF_TOKEN_FILE="$token"
export LD_LIBRARY_PATH="$ff/lib:$ff/compat:$venv/lib/python3.12/site-packages/torchcodec:$venv/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$driver:$legacy:$repo_code/scripts:$repo_code/src:$runtime:$code/scripts:$code/src:$groot:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false NO_ALBUMENTATIONS_UPDATE=1
test "$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^$/d' | wc -l)" -eq 1
nvidia-smi --query-gpu=name --format=csv,noheader | grep -qi H200
"$venv/bin/python" -u "$driver/pi0253_full_train.py" --train --run-card "$card" --resume-after-step "$resume"
status=$(jq -er .status "$output/execution_state.json")
case "$status" in WAIT_FIXED_2500_BARRIER|TRAINING_COMPLETE) ;; *) exit 1 ;; esac
