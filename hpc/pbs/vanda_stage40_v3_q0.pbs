#!/usr/bin/env bash
# Vanda A40 Stage40 V3: one real GR00T Q0 decode, no WBC step.
#PBS -N vanda_st40_v3_q0
#PBS -q interactive_gpu
#PBS -l select=1:ncpus=12:mem=64gb:ngpus=1:gpu_model=A40
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -M leonliu@u.nus.edu
#PBS -m ae

set -euo pipefail
export VANDA_STAGE40_STAGE_RUN=v3_q0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/vanda_stage40_stage_runner.sh"
