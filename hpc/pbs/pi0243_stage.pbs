#!/usr/bin/env bash
# PI0243 staged training/screen runner.  The run card is the only scientific
# configuration source; this shell only binds the sealed Hopper runtime.

#PBS -N pi0243_stage
#PBS -P CFP03-CF-004
# Training uses compute-local scratch; the sealed output is archived afterward.
# This avoids heterogeneous Project_Storage mounts across compute nodes.
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail

: "${PI0243_PROJECT_ROOT:?set PI0243_PROJECT_ROOT}"
: "${PI0243_STAGE10_ROOT:?set PI0243_STAGE10_ROOT}"
: "${PI0243_GR00T_SOURCE:?set PI0243_GR00T_SOURCE}"
: "${PI0243_RUN_CARD:?set PI0243_RUN_CARD}"
: "${PI0243_METADATA_MIRROR_ROOT:?set PI0243_METADATA_MIRROR_ROOT}"
: "${PI0243_OUTPUT_MIRROR_ROOT:?set PI0243_OUTPUT_MIRROR_ROOT}"
: "${PI0243_ARCHIVE_HOST:?set PI0243_ARCHIVE_HOST}"
: "${PI0243_ARCHIVE_ROOT:?set PI0243_ARCHIVE_ROOT}"
: "${PI0243_CHECKPOINT_FAMILY:?set PI0243_CHECKPOINT_FAMILY}"
: "${PI0243_PHASE:?set PI0243_PHASE}"
: "${PI0243_STAGE:?set PI0243_STAGE}"
: "${PI0243_FFMPEG_RUNTIME_ROOT:?set PI0243_FFMPEG_RUNTIME_ROOT}"
: "${PI0243_TORCHCODEC_PACKAGE_ROOT:?set PI0243_TORCHCODEC_PACKAGE_ROOT}"
: "${PI0243_TORCH_LIBRARY_ROOT:?set PI0243_TORCH_LIBRARY_ROOT}"
: "${PBS_JOBID:?PBS_JOBID must be present}"

PI0243_PYTHON="${PI0243_PYTHON:-${PI0243_STAGE10_ROOT}/runtime/venv/bin/python}"
test -x "${PI0243_PYTHON}"
test -d "${PI0243_FFMPEG_RUNTIME_ROOT}/lib"
test -d "${PI0243_FFMPEG_RUNTIME_ROOT}/compat"
test -d "${PI0243_TORCHCODEC_PACKAGE_ROOT}"
test -d "${PI0243_TORCH_LIBRARY_ROOT}"
test -r "${PI0243_RUN_CARD}" || { echo "FAIL_CLOSED: mirrored run card is not readable on compute node: ${PI0243_RUN_CARD}" >&2; exit 2; }
test -r "${PI0243_METADATA_MIRROR_ROOT}/stage_cohort.json" || { echo "FAIL_CLOSED: mirrored cohort is not readable" >&2; exit 2; }
test -r "${PI0243_METADATA_MIRROR_ROOT}/stage_exposure_schedule.json" || { echo "FAIL_CLOSED: mirrored schedule is not readable" >&2; exit 2; }
mkdir -p "${PI0243_OUTPUT_MIRROR_ROOT}"
test -w "${PI0243_OUTPUT_MIRROR_ROOT}" || { echo "FAIL_CLOSED: compute output mirror is not writable: ${PI0243_OUTPUT_MIRROR_ROOT}" >&2; exit 2; }
if [[ -n "${PI0243_HF_REPO_ID:-}" ]]; then
  : "${PI0243_HF_TOKEN_FILE:?set PI0243_HF_TOKEN_FILE}"
  : "${PI0243_HF_PATH_PREFIX:?set PI0243_HF_PATH_PREFIX}"
  test -r "${PI0243_HF_TOKEN_FILE}" || { echo "FAIL_CLOSED: HF token file is unreadable" >&2; exit 2; }
  unset PI0243_DURABLE_HOST PI0243_DURABLE_ROOT
else
  : "${PI0243_DURABLE_HOST:?set PI0243_DURABLE_HOST}"
  : "${PI0243_DURABLE_ROOT:?set PI0243_DURABLE_ROOT}"
  test -n "${PI0243_DURABLE_ROOT}" || { echo "FAIL_CLOSED: durable root is empty" >&2; exit 2; }
fi

ambient_ld="${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="${PI0243_FFMPEG_RUNTIME_ROOT}/lib:${PI0243_FFMPEG_RUNTIME_ROOT}/compat:${PI0243_TORCHCODEC_PACKAGE_ROOT}:${PI0243_TORCH_LIBRARY_ROOT}:${ambient_ld}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="${PI0243_PROJECT_ROOT}/src:${PI0243_PROJECT_ROOT}/scripts:${PI0243_GR00T_SOURCE}:${PYTHONPATH:-}"

GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1 | sed 's/[[:space:]]*$//')"
GPU_COUNT="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l)"
test "${GPU_COUNT}" -eq 1 || { echo "FAIL_CLOSED: expected one visible GPU, observed ${GPU_COUNT}" >&2; exit 2; }
case "${GPU_NAME}" in *H200*|*H100*) ;; *) echo "FAIL_CLOSED: expected H200/H100, observed ${GPU_NAME}" >&2; exit 2 ;; esac

cd "${PI0243_PROJECT_ROOT}"
archive_output() {
  local source_root="${PI0243_OUTPUT_MIRROR_ROOT}"
  test -d "${source_root}"
  # Checkpoints are handed off and verified by the save callback.  The exit
  # sync only publishes metadata, logs and screen evidence; it is not the
  # sole checkpoint durability mechanism.
  if [[ "${PI0243_ARCHIVE_HOST}" == "local" ]]; then
    mkdir -p "${PI0243_ARCHIVE_ROOT}"
    rsync -a --partial --human-readable --exclude='/training/checkpoint-*' "${source_root}/" "${PI0243_ARCHIVE_ROOT}/"
  else
    local destination="${PI0243_ARCHIVE_HOST}:${PI0243_ARCHIVE_ROOT}/"
    rsync -a --partial --human-readable --exclude='/training/checkpoint-*' "${source_root}/" "${destination}"
  fi
}
start_hf_sidecar() {
  if [[ -z "${PI0243_HF_REPO_ID:-}" ]]; then
    return 0
  fi
  HF_SIDECAR_LOG="${PI0243_OUTPUT_MIRROR_ROOT}/hf_checkpoint_sidecar.log"
  HF_SIDECAR_STATE="${PI0243_OUTPUT_MIRROR_ROOT}/hf_checkpoint_sidecar.jsonl"
  "${PI0243_HF_PUBLISHER_PYTHON:-${PI0243_STAGE10_ROOT}/runtime/venv/bin/python}" -u scripts/pi0243_hf_checkpoint_sidecar.py \
    --output-root "${PI0243_OUTPUT_MIRROR_ROOT}" \
    --repo-id "${PI0243_HF_REPO_ID}" \
    --token-file "${PI0243_HF_TOKEN_FILE}" \
    --path-prefix "${PI0243_HF_PATH_PREFIX}" \
    --max-steps "${PI0243_MAX_STEPS:-5000}" \
    --steps ${PI0243_CHECKPOINT_STEPS:-1000 2500 5000} \
    --state-path "${HF_SIDECAR_STATE}" >"${HF_SIDECAR_LOG}" 2>&1 &
  HF_SIDECAR_PID=$!
}
wait_hf_sidecar() {
  if [[ -z "${HF_SIDECAR_PID:-}" ]]; then
    return 0
  fi
  wait "${HF_SIDECAR_PID}"
}
case "${PI0243_PHASE}" in
  train)
    start_hf_sidecar
    set +e
    "${PI0243_PYTHON}" -u scripts/pi0243_staged_learning_to_sim.py \
      --phase train --stage "${PI0243_STAGE}" --run-card "${PI0243_RUN_CARD}" \
      --authorization "${PI0243_AUTHORIZATION:?set PI0243_AUTHORIZATION}"
    run_status=$?
    set -e
    if [[ "${run_status}" -eq 0 ]]; then
      wait_hf_sidecar || run_status=$?
    else
      if [[ -n "${HF_SIDECAR_PID:-}" ]]; then
        kill "${HF_SIDECAR_PID}" 2>/dev/null || true
        wait "${HF_SIDECAR_PID}" 2>/dev/null || true
      fi
    fi
    archive_output || { echo "FAIL_CLOSED: output archive failed" >&2; exit 3; }
    exit "${run_status}"
    ;;
  screen)
    set +e
    "${PI0243_PYTHON}" -u scripts/pi0243_staged_learning_to_sim.py \
      --phase screen --stage "${PI0243_STAGE}" --run-card "${PI0243_RUN_CARD}" \
      --device "${PI0243_DEVICE:-cuda:0}"
    run_status=$?
    set -e
    archive_output || { echo "FAIL_CLOSED: output archive failed" >&2; exit 3; }
    exit "${run_status}"
    ;;
  *) echo "FAIL_CLOSED: unsupported phase ${PI0243_PHASE}" >&2; exit 2 ;;
esac
