#!/usr/bin/env bash
# PI0241 engineering recovery: resume exact Trainer state from checkpoint-500.

#PBS -N pi0241_f16r
#PBS -P CFP03-CF-004
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

: "${PI0241_PROJECT_ROOT:?set the PI0241 checkout}"
: "${PI0241_STAGE10_ROOT:?set the Stage10 root}"
: "${PI0241_GR00T_SOURCE:?set the GR00T source}"
: "${PI0241_RUN_CARD:?set the sealed run card}"
: "${PI0241_ARCHIVE_MANIFEST:?set the archive manifest}"
: "${PI0241_FFMPEG_RUNTIME_ROOT:?set the FFmpeg6 runtime}"
: "${PI0241_TORCHCODEC_PACKAGE_ROOT:?set the torchcodec package root}"
: "${PI0241_TORCH_LIBRARY_ROOT:?set the torch library root}"
: "${PBS_JOBID:?PBS_JOBID must be present}"

PI0241_PYTHON="${PI0241_PYTHON:-${PI0241_STAGE10_ROOT}/runtime/venv/bin/python}"
ambient_ld="${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="${PI0241_FFMPEG_RUNTIME_ROOT}/lib:${PI0241_FFMPEG_RUNTIME_ROOT}/compat:${PI0241_TORCHCODEC_PACKAGE_ROOT}:${PI0241_TORCH_LIBRARY_ROOT}:${ambient_ld}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PI0241_PROJECT_ROOT}/src:${PI0241_PROJECT_ROOT}/scripts:${PI0241_GR00T_SOURCE}:${PYTHONPATH:-}"

GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1 | sed 's/[[:space:]]*$//')"
GPU_COUNT="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l)"
test "${GPU_COUNT}" -eq 1
case "${GPU_NAME}" in *H200*) ;; *) echo "FAIL_CLOSED: expected H200, observed ${GPU_NAME}" >&2; exit 2 ;; esac

cd "${PI0241_PROJECT_ROOT}"
exec "${PI0241_PYTHON}" -u scripts/pi0241_resume_and_finalize.py \
  --run-card "${PI0241_RUN_CARD}" \
  --authorization PI0241_FIXED16_1000_GO \
  --failed-job-id "${PI0241_FAILED_JOB_ID:?set failed training job id}" \
  --archive-manifest "${PI0241_ARCHIVE_MANIFEST}"
