#!/usr/bin/env bash
# Stage40-RLQ bounded native reference lifecycle canary.
# No GR00T and no Stage40 scientific rows.
#PBS -N st40_rlq
#PBS -q auto
#PBS -P CFP03-CF-004
#PBS -l select=1:ncpus=12:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -M leonliu@u.nus.edu
#PBS -m ae

set -euo pipefail
: "$STAGE40_REPO"
: "$STAGE40_OUTPUT_ROOT"
: "$STAGE40_EXPECTED_HEAD"
: "$STAGE40_AUTH_ROOT"
: "$STAGE40_TRAJECTORY"
: "$STAGE40_ARM"
: "$STAGE40_DOG"

RUN_ROOT="$STAGE40_OUTPUT_ROOT/stage40_rlq_$PBS_JOBID"
test ! -e "$RUN_ROOT"
mkdir -p "$RUN_ROOT/runtime/home" "$RUN_ROOT/runtime/tmp" "$RUN_ROOT/runtime/cache" "$RUN_ROOT/runtime/config" "$RUN_ROOT/runtime/data"
exec > >(tee -a "$RUN_ROOT/stage40_rlq.log") 2>&1

cd "$STAGE40_REPO"
test "$(git rev-parse HEAD)" = "$STAGE40_EXPECTED_HEAD"
test -z "$(git status --short --untracked-files=all)"
test -d "$STAGE40_AUTH_ROOT/WBCTrackingShare"
for path in "$STAGE40_TRAJECTORY" "$STAGE40_ARM" "$STAGE40_DOG"; do test -f "$path"; done

GPU_QUERY="$(nvidia-smi --query-gpu=name --format=csv,noheader)"
GPU_NAME="$(printf '%s\n' "$GPU_QUERY" | sed '/^[[:space:]]*$/d' | sed -n '1p' | sed 's/[[:space:]]*$//')"
GPU_COUNT="$(printf '%s\n' "$GPU_QUERY" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
test "$GPU_COUNT" = 1

IMAGE=/scratch/e1192548/Apptainer/ubuntu-desktop_24.04-cu12.6.2-isaac.sif
APPTAINER=/cm/shared/apps/singularity/1.3.1/bin/apptainer
SITE=/scratch/e1192548/leon-storage/wbc-authority/stage36_runtime_reconstruction_20260905/torch_cu121_v1/site-packages
NINJA=/scratch/e1192548/leon-storage/wbc-authority/stage36_runtime_reconstruction_20260905/torch_cu121_v1/ninja_target_v4/bin/ninja
test -f "$IMAGE"
test -x "$APPTAINER"
test -d "$SITE"
test -x "$NINJA"

export HOME="$RUN_ROOT/runtime/home" TMPDIR="$RUN_ROOT/runtime/tmp" TMP="$RUN_ROOT/runtime/tmp" TEMP="$RUN_ROOT/runtime/tmp"
export XDG_CACHE_HOME="$RUN_ROOT/runtime/cache" XDG_CONFIG_HOME="$RUN_ROOT/runtime/config" XDG_DATA_HOME="$RUN_ROOT/runtime/data"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=0
export LD_LIBRARY_PATH="/opt/miniconda3/envs/isaacgym/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cudnn/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_runtime/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cublas/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cusparse/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cufft/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/curand/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/nvjitlink/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_nvrtc/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:$SITE/torch/lib"

echo "STAGE40=Stage40-RLQ"
echo "PI_GATE=PI_GATE_STATE_0044"
echo "MODE=REFERENCE_LIFECYCLE_CANARY"
echo "HEAD=$STAGE40_EXPECTED_HEAD"
echo "PBS_JOBID=$PBS_JOBID"
echo "HOST=$(hostname)"
echo "GPU=$GPU_NAME"

CONTAINER_SITE=/runtime/site-packages
CONTAINER_NINJA=/runtime/ninja/bin
"$APPTAINER" exec --nv --cleanenv \
  --bind /scratch:/scratch \
  --bind "$STAGE40_AUTH_ROOT:/authority:ro" \
  --bind "$SITE:$CONTAINER_SITE:ro" \
  --bind "$(dirname "$NINJA"):$CONTAINER_NINJA:ro" \
  "$IMAGE" env \
  HOME="$HOME" TMPDIR="$TMPDIR" TMP="$TMP" TEMP="$TEMP" \
  XDG_CACHE_HOME="$XDG_CACHE_HOME" XDG_CONFIG_HOME="$XDG_CONFIG_HOME" XDG_DATA_HOME="$XDG_DATA_HOME" \
  PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=0 \
  PATH="/usr/local/nvidia/bin:$CONTAINER_NINJA:$PATH" \
  LD_LIBRARY_PATH="/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/.singularity.d/libs:/opt/miniconda3/envs/isaacgym/lib:$LD_LIBRARY_PATH" \
  PYTHONPATH="$STAGE40_REPO:$STAGE40_REPO/src:$STAGE40_REPO/scripts:/authority/WBCTrackingShare:$CONTAINER_SITE" \
  /opt/miniconda3/envs/isaacgym/bin/python -B \
  "$STAGE40_REPO/scripts/stage40_rlq_canary.py" \
    --source-root /authority/WBCTrackingShare \
    --trajectory "$STAGE40_TRAJECTORY" \
    --arm "$STAGE40_ARM" \
    --dog "$STAGE40_DOG" \
    --output-dir "$RUN_ROOT" \
    --sim-device cuda:0

echo "STAGE40_RLQ_RETURNED"
