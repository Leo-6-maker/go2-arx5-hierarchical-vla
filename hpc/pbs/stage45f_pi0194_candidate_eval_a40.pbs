#!/usr/bin/env bash
# PI0197: one preauthorized Vanda A40 closed-loop matrix, no smoke/retry.
# The thin Stage45F shim delegates the native loop to the immutable
# Stage43/Stage40 implementation. Scheduler output stays outside the repo.
#PBS -N pi0197_cl
#PBS -q interactive_gpu
#PBS -l select=1:ncpus=36:ngpus=1:mem=240gb
#PBS -l walltime=02:00:00
#PBS -o /scratch/leonliu/pi0197_candidate_eval_a40.scheduler.log
#PBS -j oe

set -euo pipefail

: "${PI0197_REPO:?}"
: "${PI0197_BINDING:?}"
: "${PI0197_EXPECTED_HEAD:?}"

APPTAINER="${PI0197_APPTAINER:-/cm/shared/apps/apptainer/1.4.1/bin/apptainer}"
NATIVE_IMAGE="${PI0197_NATIVE_IMAGE:-/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/packages/ubuntu-desktop_24.04-cu12.6.2-isaac.sif}"
NATIVE_SITE="${PI0197_NATIVE_SITE:-/scratch/leonliu/pi0191_runtime/torch_cu121_v1/site-packages}"
GROOT_SITE="${PI0197_GROOT_SITE:-/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/materialized/stage22_runtime/runtime/venv/lib/python3.12/site-packages}"
NATIVE_NINJA="${PI0197_RUNTIME_NINJA:-/scratch/leonliu/pi0197_runtime/pi0197_ninja_target_v4_08639e19/bin/ninja}"

RUN_LOG_ROOT="${PI0197_RUN_LOG_ROOT:-$(dirname "${PI0197_BINDING}")/runs/${PBS_JOBID}}"
test ! -e "${RUN_LOG_ROOT}"
mkdir -p "${RUN_LOG_ROOT}"
exec > >(tee -a "${RUN_LOG_ROOT}/pbs.log") 2>&1
printf 'PI0197 wrapper start job=%s host=%s\n' "${PBS_JOBID}" "$(hostname)"

test -x "${APPTAINER}"
test -f "${NATIVE_IMAGE}"
test -d "${GROOT_SITE}"
test -x "${NATIVE_NINJA}"
test -f "${PI0197_BINDING}"
"${APPTAINER}" --version

GPU_UUID="$(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed -n '1p' | tr -d '[:space:]')"
GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed -n '1p' | sed 's/[[:space:]]*$//')"
GPU_COUNT="$(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
test "${GPU_COUNT}" = 1
test "${GPU_NAME}" = "NVIDIA A40"
printf 'PI0197 GPU name=%s uuid=%s count=%s\n' "${GPU_NAME}" "${GPU_UUID}" "${GPU_COUNT}"

cd "${PI0197_REPO}"
test "$(git rev-parse HEAD)" = "${PI0197_EXPECTED_HEAD}"
test -z "$(git status --short --untracked-files=all)"

export CUDA_VISIBLE_DEVICES=0
export PI0197_FFMPEG_BIN="${PI0197_FFMPEG_BIN:-/usr/bin/ffmpeg}"
export PI0197_WORKER_LD_LIBRARY_PATH="${PI0197_WORKER_LD_LIBRARY_PATH:-/runtime/site-packages/torch/lib:/opt/miniconda3/envs/isaacgym/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cudnn/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_runtime/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cublas/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu}"

export PI0197_HOME="${RUN_LOG_ROOT}/runtime/home"
export PI0197_TMP="${RUN_LOG_ROOT}/runtime/tmp"
export PI0197_CACHE="${RUN_LOG_ROOT}/runtime/cache"
export TORCH_EXTENSIONS_DIR="${PI0197_CACHE}/torch_extensions"
mkdir -p "${PI0197_HOME}" "${PI0197_TMP}" "${PI0197_CACHE}" "${TORCH_EXTENSIONS_DIR}"

NATIVE_LD="/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/.singularity.d/libs:/opt/miniconda3/envs/isaacgym/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cudnn/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_runtime/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cublas/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cusparse/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cufft/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/curand/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/nvjitlink/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_nvrtc/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:${NATIVE_SITE}/torch/lib"

"${APPTAINER}" exec --nv --cleanenv \
  --bind /scratch:/scratch \
  --bind /nfs:/nfs \
  --bind "${PI0197_REPO}:${PI0197_REPO}:ro" \
  --bind "${NATIVE_SITE}:/runtime/site-packages:ro" \
  --bind "${GROOT_SITE}:/runtime/groot-site:ro" \
  --bind "$(dirname "${NATIVE_NINJA}"):/runtime/ninja/bin:ro" \
  --bind "/scratch/leonliu/pi0197_runtime/stage43_corelab_controlled_cohort_20260908:/var/cache/users/liuyu-nfs/stage43_corelab_controlled_cohort_20260908:ro" \
  --bind "/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1:/var/cache/users/liuyu-nfs/stage40_frozen_inputs_20260907_v1:ro" \
  --bind "/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/materialized/stage22_runtime:/var/cache/users/liuyu-nfs/go2-arx5-vla-stage10:ro" \
  --bind "/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/materialized/groot_base_model/GR00T-N1.7-3B:/var/cache/users/liuyu-nfs/go2-arx5-vla-stage10/assets/GR00T-N1.7-3B:ro" \
  --bind "/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/materialized/modality/go2_arx5_modality.py:/var/cache/users/liuyu-nfs/go2-arx5-vla-stage10/artifacts/go2_arx5_modality.py:ro" \
  --bind "/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/materialized/tiny1_h2stats_lerobot_v2/tiny1_h2stats_lerobot_v2:/var/cache/users/liuyu-nfs/go2-arx5-vla-stage23/action_pipeline_20260903_p0/tiny1_h2stats_lerobot_v2:ro" \
  --bind "/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/materialized/wbc/WBCTrackingShare:/var/cache/users/liuyu-nfs/go2-arx5-wbc-stage13/extracted/WBCTrackingShare:ro" \
  --bind "/scratch/leonliu/pi0192_stage43_input_relay/E1_W0_00.npz:/var/cache/users/liuyu-nfs/go2-arx5-vla-stage40-rtx4080s/R2_native_camera_20260907/trajectory_input.npz:ro" \
  "${NATIVE_IMAGE}" env \
  HOME="${PI0197_HOME}" TMPDIR="${PI0197_TMP}" TMP="${PI0197_TMP}" TEMP="${PI0197_TMP}" \
  XDG_CACHE_HOME="${PI0197_CACHE}" \
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
  PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=0 \
  TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR}" \
  PATH="/usr/local/nvidia/bin:/runtime/ninja/bin:${PATH}" \
  LD_LIBRARY_PATH="${NATIVE_LD}" \
  PYTHONPATH="${PI0197_REPO}:${PI0197_REPO}/src:${PI0197_REPO}/scripts:/runtime/site-packages" \
  /opt/miniconda3/envs/isaacgym/bin/python -B \
  "${PI0197_REPO}/scripts/stage45f_pi0194_candidate_eval.py" \
  --execute "${PI0197_BINDING}" \
  --expected-head "${PI0197_EXPECTED_HEAD}" \
  --gpu-uuid "${GPU_UUID}" \
  --sim-device cuda:0 \
  --seed 4242
