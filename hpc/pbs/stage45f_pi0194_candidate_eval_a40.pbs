#!/usr/bin/env bash
# PI0194: one authorized A40 closed-loop matrix, no smoke and no retry.
# The binding JSON is created only after the pushed execution HEAD is known.
# The adapter performs all CPU admission and checkpoint/inventory verification
# before starting the first worker or native simulator.
#PBS -N pi0194_cl
#PBS -q interactive_gpu
#PBS -l select=1:ncpus=36:ngpus=1:mem=240gb
#PBS -l walltime=02:00:00
# PBS owns stdout before this script starts. Keep that scheduler-owned file
# outside the Git checkout so the strict clean-worktree admission stays valid.
#PBS -o /scratch/leonliu/pi0194_candidate_eval_a40.scheduler.log
#PBS -j oe

set -euo pipefail

: "${PI0194_REPO:?}"
: "${PI0194_BINDING:?}"
: "${PI0194_EXPECTED_HEAD:?}"

APPTAINER="${PI0194_APPTAINER:-/cm/shared/apps/apptainer/1.4.1/bin/apptainer}"
NATIVE_IMAGE="${PI0194_NATIVE_IMAGE:-/scratch/leonliu/leon-storage/stage40_frozen_inputs_20260907_v1/packages/ubuntu-desktop_24.04-cu12.6.2-isaac.sif}"
NATIVE_SITE="${PI0194_NATIVE_SITE:-/scratch/leonliu/pi0191_runtime/torch_cu121_v1/site-packages}"

RUN_LOG_ROOT="${PI0194_RUN_LOG_ROOT:-$(dirname "${PI0194_BINDING}")/runs/${PBS_JOBID}}"
test ! -e "${RUN_LOG_ROOT}"
mkdir -p "${RUN_LOG_ROOT}"
exec > >(tee -a "${RUN_LOG_ROOT}/pbs.log") 2>&1
printf 'PI0194 wrapper start job=%s host=%s\n' "${PBS_JOBID}" "$(hostname)"

test -x "${APPTAINER}"
test -f "${NATIVE_IMAGE}"
test -f "${PI0194_BINDING}"
"${APPTAINER}" --version

GPU_UUID="$(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed -n '1p' | tr -d '[:space:]')"
GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed -n '1p' | sed 's/[[:space:]]*$//')"
GPU_COUNT="$(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
test "${GPU_COUNT}" = 1
test "${GPU_NAME}" = "NVIDIA A40"
printf 'PI0194 GPU name=%s uuid=%s count=%s\n' "${GPU_NAME}" "${GPU_UUID}" "${GPU_COUNT}"

cd "${PI0194_REPO}"
test "$(git rev-parse HEAD)" = "${PI0194_EXPECTED_HEAD}"
test -z "$(git status --short --untracked-files=all)"

export CUDA_VISIBLE_DEVICES=0
export PI0194_FFMPEG_BIN="${PI0194_FFMPEG_BIN:-/usr/bin/ffmpeg}"
export PI0194_WORKER_LD_LIBRARY_PATH="${PI0194_WORKER_LD_LIBRARY_PATH:-/runtime/site-packages/torch/lib:/opt/miniconda3/envs/isaacgym/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cudnn/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_runtime/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cublas/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu}"

export PI0194_HOME="${RUN_LOG_ROOT}/runtime/home"
export PI0194_TMP="${RUN_LOG_ROOT}/runtime/tmp"
export PI0194_CACHE="${RUN_LOG_ROOT}/runtime/cache"
mkdir -p "${PI0194_HOME}" "${PI0194_TMP}" "${PI0194_CACHE}"

NATIVE_LD="/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/.singularity.d/libs:/opt/miniconda3/envs/isaacgym/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cudnn/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_runtime/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cublas/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cusparse/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cufft/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/curand/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/nvjitlink/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda_nvrtc/lib:/opt/miniconda3/envs/isaacgym/lib/python3.8/site-packages/nvidia/cuda/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:${NATIVE_SITE}/torch/lib"

"${APPTAINER}" exec --nv --cleanenv \
  --bind /scratch:/scratch \
  --bind /nfs:/nfs \
  --bind "${PI0194_REPO}:${PI0194_REPO}:ro" \
  --bind "${NATIVE_SITE}:/runtime/site-packages:ro" \
  "${NATIVE_IMAGE}" env \
  HOME="${PI0194_HOME}" TMPDIR="${PI0194_TMP}" TMP="${PI0194_TMP}" TEMP="${PI0194_TMP}" \
  XDG_CACHE_HOME="${PI0194_CACHE}" \
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
  PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=0 \
  PATH="/usr/local/nvidia/bin:${PATH}" \
  LD_LIBRARY_PATH="${NATIVE_LD}" \
  PYTHONPATH="${PI0194_REPO}:${PI0194_REPO}/src:${PI0194_REPO}/scripts:/runtime/site-packages" \
  /opt/miniconda3/envs/isaacgym/bin/python -B \
  "${PI0194_REPO}/scripts/stage45f_pi0194_candidate_eval.py" \
  --execute "${PI0194_BINDING}" \
  --expected-head "${PI0194_EXPECTED_HEAD}" \
  --gpu-uuid "${GPU_UUID}" \
  --sim-device cuda:0 \
  --seed 4242
