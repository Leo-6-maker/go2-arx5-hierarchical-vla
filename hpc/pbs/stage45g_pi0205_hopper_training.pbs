#!/bin/bash
# PI0205 three-arm training on one automatically selected Hopper GPU.
# ponytail: reuse the PI0183 envelope; the Python entrypoint owns science validation.
#PBS -N st45g_pi0205
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -l select=1:ngpus=1:ncpus=12:mem=225gb
#PBS -l walltime=04:00:00
#PBS -r n

set -euo pipefail

REPO=/scratch/e1192548/stage45f_pi0188_hopper_worktree_v3
EXPECTED_HEAD=6fdccecff717683fbab7d05cae1e294fab2dd482
PYTHON=/scratch/e1192548/stage22_h200_runtime_deb920_20260902/runtime/venv/bin/python
OUTPUT_BASE=/hpctmp/e1192548/stage45g_pi0205_hopper_training_20260916
NEUTRAL_BASE=/scratch/e1192548/pi0205_hopper_neutral_20260916

SCHEDULE=$REPO/reports/stage45g_pi0200_e256_support_dose_response_20260916/dose_response_schedule.json
ROWS=$REPO/reports/stage45f_pi0182_state_support_training_admission_20260914/origin_classified_rows.jsonl
SUPPORT_ROOT=$REPO/reports/stage45f_pi0181_visited_state_support_20260914
DATASET=/scratch/e1192548/stage22_handoff_deb920a_20260902/payload/lerobot_train
BASE_MODEL=/hpctmp/e1192548/stage45f_pi0188_es20_training/617089.hopper-m-02_/E/checkpoint-256
GROOT_SOURCE=/scratch/e1192548/stage45c_pi0094_native_runtime_20260909/groot-source-v4
GROOT_MANIFEST=/scratch/e1192548/stage45b_pi0086_groot_snapshot__zhu4zz2/STAGE45B_GROOT_SOURCE_SNAPSHOT_V2.manifest.json
COSMOS_ROOT=/scratch/e1192548/stage22_h200_cosmos_v2_20260902/hf_home/hub/models--nvidia--Cosmos-Reason2-2B
MODALITY=/scratch/e1192548/stage22_handoff_deb920a_20260902/payload/modality/go2_arx5_modality.py
CONFIG=/scratch/e1192548/stage28_h2_20260904/stage28_h2_600695.hopper-m-02/h2_training/experiment_cfg/config.yaml
STATS=/scratch/e1192548/leon-storage/runs/stage38_structured_groot_offline_20260906/stage38d_train_a7f6880/experiment_cfg/structured_action_statistics.json
FFMPEG_ROOT=/scratch/e1192548/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__9243a7880b06ac3984ddf4a1a667b685441ec0f34d6d529fa0f96c3c894e10cf
TORCH_SITE=/scratch/e1192548/stage22_h200_runtime_deb920_20260902/runtime/venv/lib/python3.12/site-packages

run_id=$(printf '%s' "$PBS_JOBID" | tr -c 'A-Za-z0-9_.-' '_')
run_root=$OUTPUT_BASE/$run_id
neutral_root=$NEUTRAL_BASE/$run_id
mkdir -p "$run_root" "$neutral_root"
test ! -e "$run_root/C80" && test ! -e "$run_root/S25" && test ! -e "$run_root/S50"
exec >"$neutral_root/job.log" 2>&1

hostname
date -u
actual_head=$(git -C "$REPO" rev-parse HEAD)
test "$actual_head" = "$EXPECTED_HEAD"
test -z "$(git -C "$REPO" status --porcelain)"
test "$(git -C "$REPO" branch --show-current)" = stage45g/e256-state-support-dose-response

gpu_count=$(nvidia-smi --query-gpu=uuid --format=csv,noheader | awk 'NF {n++} END {print n+0}')
test "$gpu_count" -eq 1
gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader | awk 'NF {print; exit}')
case "$gpu_name" in
  *H100*|*H200*) ;;
  *) echo "unsupported GPU: $gpu_name" >&2; exit 2 ;;
esac
gpu_uuid=$(nvidia-smi --query-gpu=uuid --format=csv,noheader | awk 'NF {print $1; exit}')
gpu_free_mib=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | awk 'NR==1 {print int($1)}')
test "$gpu_free_mib" -ge 12288
nvidia-smi --query-gpu=index,name,uuid,memory.total,memory.free,memory.used --format=csv
nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv
echo "selected_gpu=$gpu_name"
echo "selected_uuid=$gpu_uuid"
export CUDA_VISIBLE_DEVICES=0

ffmpeg_lib=$FFMPEG_ROOT/lib
ffmpeg_compat=$FFMPEG_ROOT/compat
torchcodec_root=$TORCH_SITE/torchcodec
torch_library_root=$TORCH_SITE/torch/lib
test -d "$ffmpeg_lib" && test -d "$ffmpeg_compat"
test -d "$torchcodec_root" && test -d "$torch_library_root"
ambient_ld=${LD_LIBRARY_PATH:-}
if test -n "$ambient_ld"; then
  export LD_LIBRARY_PATH="$ffmpeg_lib:$ffmpeg_compat:$torchcodec_root:$torch_library_root:$ambient_ld"
else
  export LD_LIBRARY_PATH="$ffmpeg_lib:$ffmpeg_compat:$torchcodec_root:$torch_library_root"
fi
unset PYTHONPATH
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export GROOT_HF_LOCAL_FIRST=1
export GROOT_PATCH_MISTRAL=1
export GROOT_COMMIT_HASH=51d4c89f72fda44cbf77285c6a8114b52676b8a1

train_arm() {
  arm=$1
  output=$run_root/$arm
  test ! -e "$output" && test ! -L "$output"
  "$PYTHON" "$REPO/scripts/stage45f_pi0183_matched_training.py" \
    --train --arm "$arm" --output "$output" \
    --schedule "$SCHEDULE" \
    --rows "$ROWS" \
    --support-root "$SUPPORT_ROOT" \
    --dataset "$DATASET" \
    --base-model "$BASE_MODEL" \
    --groot-source "$GROOT_SOURCE" \
    --groot-manifest "$GROOT_MANIFEST" \
    --cosmos-root "$COSMOS_ROOT" \
    --modality "$MODALITY" \
    --config "$CONFIG" \
    --stats "$STATS" \
    --ffmpeg-root "$FFMPEG_ROOT"
}

train_arm C80
train_arm S25
train_arm S50

date -u
echo "PI0205_HOPPER_TRAINING_COMPLETE"
