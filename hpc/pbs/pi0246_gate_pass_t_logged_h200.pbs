#!/usr/bin/env bash
#PBS -N pi0246_gate_pass_T
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=16:00:00
#PBS -o /scratch/e1192548/pi0246_gate_pass_logs/
#PBS -e /scratch/e1192548/pi0246_gate_pass_logs/

set -euo pipefail
trap 'rc=$?; echo "PI0246_T_TRAIN_FAILURE line=${LINENO} status=${rc}" >&2' ERR

card=${PI0246_RUN_CARD:?sealed T card required}
expected=${PI0246_RUN_CARD_SHA256:?sealed card SHA required}
runtime=${PI0246_T_RUNTIME_ROOT:?sealed T runtime root required}
wrapper="$runtime/pi0246_gate_pass_t_logged_h200.pbs"
test -r "$card"
test "$(sha256sum "$card" | cut -d ' ' -f 1)" = "$expected"
test "$(jq -er .arm "$card")" = T
test "$(jq -er .family "$card")" = PI0245_T_PHYSDELTA_M16_2K_V1
test "$(jq -er .loss "$card")" = 'L_native + 0.1 * L_phys_delta'

code=$(jq -er .paths.code_root "$card")
campaign=$(jq -er .paths.campaign_code_root "$card")
stage10=$(jq -er .paths.stage10_root "$card")
groot=$(jq -er .paths.groot_source "$card")
output=$(jq -er .paths.output_root "$card")
ff=/scratch/e1192548/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__9243a7880b06ac3984ddf4a1a667b685441ec0f34d6d529fa0f96c3c894e10cf
venv="$stage10/runtime/venv"
binding="$runtime/T_runtime_binding.json"
binding_seal="$runtime/T_runtime_binding.seal.json"
test -r "$runtime/pi0246_gate_pass_train.py"
test -r "$runtime/pi0245_native_overlay.py"
test -r "$runtime/pi0245_physical_delta.py"
test -r "$runtime/pi0246_reconcile_c_update.py"
test -r "$wrapper"
test -r "$binding" && test -r "$binding_seal"
binding_sha=$(jq -er .sha256 "$binding_seal")
test "$(sha256sum "$binding" | cut -d ' ' -f 1)" = "$binding_sha"
for helper in pi0241_fixed16_learning.py pi0228_h200_large_adapt_v1.py; do
  expected_helper=$(jq -er --arg name "$helper" '.training_helpers[$name]' "$binding")
  test "$(sha256sum "$code/scripts/$helper" | cut -d ' ' -f 1)" = "$expected_helper"
done
expected_reconciliation=$(jq -er .reconciliation_script_sha256 "$binding")
test "$(sha256sum "$runtime/pi0246_reconcile_c_update.py" | cut -d ' ' -f 1)" = "$expected_reconciliation"
test -r "$campaign/pi0246_gate_pass_train.py"
test -r "$campaign/pi0245_native_overlay.py"
test -r "$campaign/pi0245_physical_delta.py"
test -r "$campaign/pi0245_p1_stock.py"
test -r "$code/scripts/pi0241_fixed16_learning.py"
test -x "$venv/bin/python"
test -d "$ff/lib"
test -d "$output"
test ! -e "$output/training"
test ! -e "$output/training_reconciliation.json"
test -w "$output"
available=$(stat -f -c '%a %s' "$output" | awk '{print $1*$2}')
awk -v a="$available" 'BEGIN {exit !(a >= 60*1024*1024*1024)}' || { echo "FAIL_CLOSED: <60 GiB scratch checkpoint headroom" >&2; exit 2; }

export PI0246_T_RUNTIME_ROOT="$runtime"
export PI0246_T_RUNTIME_WRAPPER="$wrapper"
export PI0246_T_RUNTIME_BINDING="$binding"
export PI0246_T_RUNTIME_BINDING_SHA256="$binding_sha"
export LD_LIBRARY_PATH="$ff/lib:$ff/compat:$venv/lib/python3.12/site-packages/torchcodec:$venv/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$runtime:$campaign:$code/scripts:$code/src:$groot:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false NO_ALBUMENTATIONS_UPDATE=1
test "$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^$/d' | wc -l)" -eq 1
gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^$/d')
echo "$gpu_name" | grep -qi H200
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader
"$venv/bin/python" -u "$runtime/pi0246_gate_pass_train.py" --functional-preflight --run-card "$card"
"$venv/bin/python" -u "$runtime/pi0246_gate_pass_train.py" --train --run-card "$card"
"$venv/bin/python" -u "$runtime/pi0246_reconcile_c_update.py" \
  --run-card "$card" --training-root "$output/training" \
  --output "$output/training_reconciliation.json"
reconciliation_status=$(jq -er .status "$output/training_reconciliation.json")
test "$reconciliation_status" = TRAINING_INTEGRITY_RECONCILED_T_FULL_PROJECTOR_TENSORS
