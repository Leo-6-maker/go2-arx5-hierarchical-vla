#!/usr/bin/env bash
#PBS -N pi0245_p1_stock
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=04:00:00
#PBS -o /scratch/e1192548/pi0245_physical_temporal_pilot_20260924/logs/
#PBS -e /scratch/e1192548/pi0245_physical_temporal_pilot_20260924/logs/

set -euo pipefail
trap 'rc=$?; echo "PI0245_P1_FAILURE line=${LINENO} status=${rc}" >&2' ERR

RUNTIME=/scratch/e1192548/stage22_h200_runtime_deb920_20260902/runtime/venv/bin/python
STAGE10=/scratch/e1192548/stage22_h200_runtime_deb920_20260902
CODE=/scratch/e1192548/pi0244_fixed16_10k_v1
GROOT=${STAGE10}/src/isaac-gr00t
RUN_ROOT=/scratch/e1192548/pi0244_m16_10k_v1_r1_compute
CARD=${RUN_ROOT}/pi0243_run_card.json
NOISE=/scratch/e1192548/pi0245_physical_temporal_pilot_20260924/p1_noise_bank
SCRIPT=/scratch/e1192548/pi0245_physical_temporal_pilot_20260924/code/pi0245_p1_stock.py
OUT=/scratch/e1192548/pi0245_physical_temporal_pilot_20260924/p1
ARCHIVE=/Project_Storage/CFP-03/CFP03-CF-004/pi0245_physical_temporal_pilot_20260924/p1
R0=/Project_Storage/CFP-03/CFP03-CF-004/pi0245_physical_temporal_pilot_20260924/models/R0
R2=/Project_Storage/CFP-03/CFP03-CF-004/pi0245_physical_temporal_pilot_20260924/models/R2

mkdir -p "${OUT}" "${ARCHIVE}" /scratch/e1192548/pi0245_physical_temporal_pilot_20260924/logs
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
export PYTHONPATH="${CODE}/scripts:${CODE}/src:${GROOT}:${PYTHONPATH:-}"

archive() {
  rc=$?
  trap - EXIT
  if [[ -d "${OUT}" && -d "${ARCHIVE}" ]]; then
    rsync -a --checksum --partial "${OUT}/" "${ARCHIVE}/" || rc=90
  fi
  exit "${rc}"
}
trap archive EXIT

test -x "${RUNTIME}"
test -r "${CARD}"
test -r "${RUN_ROOT}/pi0243_run_card.seal.json"
test -r "${SCRIPT}"
test -r "${NOISE}/manifest.json"
test -r "${R0}/pi0245_inference_restore.json"
test -r "${R2}/pi0245_inference_restore.json"
test -r "${RUN_ROOT}/screen/step-10000/records.jsonl"

CARD_SHA="$(sha256sum "${CARD}" | awk '{print $1}')"
test "${CARD_SHA}" = "12e09718d5499aece46800b348f733d1bb506400d0468cb128f233f571f75191"
"${RUNTIME}" -u "${SCRIPT}" --r0-root "${RUN_ROOT}" --run-card "${CARD}" --noise-root "${NOISE}" --model-root "${R0}" --model-name R0 --output-root "${OUT}" --source-index 0 --noise-name N0 --model-preflight
"${RUNTIME}" -u "${SCRIPT}" --r0-root "${RUN_ROOT}" --run-card "${CARD}" --noise-root "${NOISE}" --model-root "${R2}" --model-name R2 --output-root "${OUT}" --source-index 0 --noise-name N0 --model-preflight
"${RUNTIME}" -u "${SCRIPT}" --r0-root "${RUN_ROOT}" --run-card "${CARD}" --noise-root "${NOISE}" --model-root "${R0}" --model-name R0 --output-root "${OUT}" --source-index 0 --noise-name N0 --bind-preflight
"${RUNTIME}" -u "${SCRIPT}" --r0-root "${RUN_ROOT}" --run-card "${CARD}" --noise-root "${NOISE}" --model-root "${R0}" --model-name R0 --output-root "${OUT}" --source-index 0 --noise-name N0 --label-preflight

GPU_QUERY="$(nvidia-smi --query-gpu=name --format=csv,noheader)"
GPU_NAME="$(printf '%s\n' "${GPU_QUERY}" | sed '/^[[:space:]]*$/d' | head -n 1 | sed 's/[[:space:]]*$//')"
GPU_COUNT="$(printf '%s\n' "${GPU_QUERY}" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
echo "PI0245_P1_GPU_PREFLIGHT host=${HOSTNAME:-unknown} count=${GPU_COUNT} name=${GPU_NAME:-unknown} job=${PBS_JOBID:-unknown}"
test "${GPU_COUNT}" -eq 1
case "${GPU_NAME}" in *H200*|*H100*) ;; *) echo "unexpected GPU ${GPU_NAME}" >&2; exit 2 ;; esac

"${RUNTIME}" -u "${SCRIPT}" --r0-root "${RUN_ROOT}" --run-card "${CARD}" --noise-root "${NOISE}" --model-root "${R0}" --model-name R0 --output-root "${OUT}" --source-index 0 --noise-name N0 --all
"${RUNTIME}" -u "${SCRIPT}" --r0-root "${RUN_ROOT}" --run-card "${CARD}" --noise-root "${NOISE}" --model-root "${R2}" --model-name R2 --output-root "${OUT}" --source-index 0 --noise-name N0 --all
