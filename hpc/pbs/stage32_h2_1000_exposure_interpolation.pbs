#!/bin/bash
# Stage32 only: H2@1000, 9 fixed probes + 3 stock sampler calls.
# Do not submit without the PI gate and exact hashes.
#PBS -N st32_h2_1000
#PBS -P CFP03-CF-004
#PBS -l select=1:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail

: "${STAGE32_REPO:?}"
: "${STAGE32_OUTPUT_PARENT:?}"
: "${STAGE32_BASE_MODEL_PATH:?}"
: "${STAGE32_DATASET_DIR:?}"
: "${STAGE32_GROOT_SOURCE:?}"
: "${STAGE32_COSMOS_SNAPSHOT:?}"
: "${STAGE32_MODALITY_CONFIG:?}"
: "${STAGE32_SNAPSHOT_ROOT:?}"
: "${STAGE32_H2_CHECKPOINT_1000:?}"
: "${STAGE32_H2_CHECKPOINT_2000:?}"
: "${STAGE32_H2_CHECKPOINT_2000_SEAL:?}"
: "${STAGE32_STAGE28_EXECUTION_MANIFEST:?}"
: "${STAGE32_STAGE28_RESULT:?}"
: "${STAGE32_STAGE31_ROOT:?}"
: "${STAGE32_STAGE31_RESULT:?}"
: "${STAGE32_STAGE31_POSTHOC:?}"
: "${STAGE32_EXPECTED_PROJECT_SHA:?}"
: "${STAGE32_PI_GATE_ID:?}"
: "${PBS_JOBID:?}"
test "$STAGE32_PI_GATE_ID" = PI_GATE_STATE_0013
cd "$STAGE32_REPO"
RUN_ROOT="${STAGE32_OUTPUT_PARENT}/stage32_${PBS_JOBID}"
test ! -e "$RUN_ROOT"
mkdir -p "$RUN_ROOT/runtime/tmp" "$RUN_ROOT/runtime/cache" "$RUN_ROOT/runtime/config" "$RUN_ROOT/runtime/data"
export TMPDIR="$RUN_ROOT/runtime/tmp" TMP="$RUN_ROOT/runtime/tmp" TEMP="$RUN_ROOT/runtime/tmp"
export HF_HOME="$RUN_ROOT/runtime/cache/huggingface" TORCH_HOME="$RUN_ROOT/runtime/cache/torch"
export XDG_CACHE_HOME="$RUN_ROOT/runtime/cache" XDG_CONFIG_HOME="$RUN_ROOT/runtime/config" XDG_DATA_HOME="$RUN_ROOT/runtime/data"
export TRITON_CACHE_DIR="$RUN_ROOT/runtime/cache/triton" TORCH_EXTENSIONS_DIR="$RUN_ROOT/runtime/cache/torch_extensions"
export PYTHONNOUSERSITE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
mkdir -p "$HF_HOME/hub" "$TORCH_HOME" "$TRITON_CACHE_DIR" "$TORCH_EXTENSIONS_DIR"
ln -s "$STAGE32_COSMOS_SNAPSHOT" "$HF_HOME/hub/models--nvidia--Cosmos-Reason2-2B"
. /etc/profile.d/modules.sh 2>/dev/null || true
module load singularity
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_25.12-py3.sif
FFMPEG_BUNDLE=/scratch/e1192548/stage22_h200_ffmpeg4_bundle_20260902
CONTAINER_SITE="${STAGE10_ROOT:-/scratch/e1192548/stage23_o1_20260903/stage10_root}/runtime/venv/lib/python3.12/site-packages"
test -f "$IMAGE" -d "$FFMPEG_BUNDLE" -d "$CONTAINER_SITE"
GPU_COUNT="$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l)"
GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n1 | sed 's/[[:space:]]*$//')"
test "$GPU_COUNT" -eq 1
case "$GPU_NAME" in *H200*) ;; *) echo "FAIL_CLOSED_GPU=$GPU_NAME" >&2; exit 2 ;; esac
FFMPEG_LD="/.singularity.d/libs:${FFMPEG_BUNDLE}:${FFMPEG_BUNDLE}/lib/x86_64-linux-gnu:${FFMPEG_BUNDLE}/usr/lib/x86_64-linux-gnu:${FFMPEG_BUNDLE}/usr/lib/x86_64-linux-gnu/pulseaudio:${CONTAINER_SITE}/torch/lib"
RUNNER=scripts/stage32_h2_1000_exposure_interpolation.py
PBS_TEMPLATE=hpc/pbs/stage32_h2_1000_exposure_interpolation.pbs
RUNNER_SHA="$(sha256sum "$RUNNER" | awk '{print $1}')"
PBS_SHA="$(sha256sum "$PBS_TEMPLATE" | awk '{print $1}')"
run_stage32() {
  singularity exec --nv --bind /app1:/app1 --bind /scratch:/scratch "$IMAGE" env \
    PYTHONPATH="${STAGE32_REPO}:${STAGE32_REPO}/src:${CONTAINER_SITE}:${STAGE32_GROOT_SOURCE}" \
    LD_LIBRARY_PATH="$FFMPEG_LD" HF_HOME="$HF_HOME" HF_HUB_CACHE="$HF_HOME/hub" \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
    GROOT_HF_LOCAL_FIRST=1 GROOT_PATCH_MISTRAL=1 XDG_CACHE_HOME="$XDG_CACHE_HOME" \
    XDG_CONFIG_HOME="$XDG_CONFIG_HOME" XDG_DATA_HOME="$XDG_DATA_HOME" TORCH_HOME="$TORCH_HOME" \
    TRITON_CACHE_DIR="$TRITON_CACHE_DIR" TORCH_EXTENSIONS_DIR="$TORCH_EXTENSIONS_DIR" \
    TMPDIR="$TMPDIR" PYTHONNOUSERSITE=1 python3 "$@"
}
COMMON=(--project-repo "$STAGE32_REPO" --expected-project-sha "$STAGE32_EXPECTED_PROJECT_SHA"
  --base-model-path "$STAGE32_BASE_MODEL_PATH" --dataset-dir "$STAGE32_DATASET_DIR"
  --groot-source "$STAGE32_GROOT_SOURCE" --cosmos-snapshot "$STAGE32_COSMOS_SNAPSHOT"
  --modality-config "$STAGE32_MODALITY_CONFIG" --snapshot-root "$STAGE32_SNAPSHOT_ROOT"
  --h2-checkpoint-1000 "$STAGE32_H2_CHECKPOINT_1000" --h2-checkpoint-2000 "$STAGE32_H2_CHECKPOINT_2000"
  --h2-checkpoint-2000-seal "$STAGE32_H2_CHECKPOINT_2000_SEAL"
  --stage28-execution-manifest "$STAGE32_STAGE28_EXECUTION_MANIFEST" --stage28-result "$STAGE32_STAGE28_RESULT"
  --stage31-root "$STAGE32_STAGE31_ROOT" --stage31-result "$STAGE32_STAGE31_RESULT"
  --stage31-posthoc "$STAGE32_STAGE31_POSTHOC" --output-root "$RUN_ROOT"
  --pbs-template "$STAGE32_REPO/$PBS_TEMPLATE" --runner-sha256 "$RUNNER_SHA" --pbs-sha256 "$PBS_SHA"
  --authorization-token "$STAGE32_PI_GATE_ID" --pbs-job-id "$PBS_JOBID" --pbs-project CFP03-CF-004 --device cuda:0)
run_stage32 "$RUNNER" --mode preflight "${COMMON[@]}"
run_stage32 "$RUNNER" --mode execute "${COMMON[@]}"
echo STAGE32_EXECUTION_COMPLETE
echo RUN_ROOT="$RUN_ROOT"
echo NEXT_GATE=GPT_PI_REVIEW_AFTER_STAGE32_EXPOSURE_CURVE
