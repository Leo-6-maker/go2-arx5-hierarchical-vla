#!/usr/bin/env bash
#PBS -N pi0252_ag
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -m n
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=16:00:00
#PBS -o /scratch/e1192548/Projects/go2-arx5/experiments/PI0252/r1-speed-margin-20260928/logs/
#PBS -e /scratch/e1192548/Projects/go2-arx5/experiments/PI0252/r1-speed-margin-20260928/logs/

set -euo pipefail
trap 'rc=$?; echo "PI0252_AG_FAILURE line=${LINENO} status=${rc}" >&2' ERR
card=${PI0252_RUN_CARD:?sealed PI0252 run card is required}
expected=${PI0252_RUN_CARD_SHA256:?run-card SHA256 is required}
arm=${PI0252_ARM:?A or G arm is required}
case "$arm" in A|G) ;; *) exit 2 ;; esac
test "$(sha256sum "$card" | cut -d ' ' -f 1)" = "$expected"
test "$(jq -er .sha256 "$(dirname "$card")/run_card.seal.json")" = "$expected"
test "$(jq -er .schema "$card")" = PI0252_AG_RUN_CARD_V1
test "$(jq -er .protocol "$card")" = PI0252
test "$(jq -er .arm "$card")" = "$arm"
test "$(jq -er .status "$card")" = SEALED_READY_NOT_STARTED
test "$(jq -er .authorization "$card")" = PI0252_R1_SPEED_MARGIN_TO_FULL_FINETUNE_GO
test "$(jq -er .execution_authorization "$card")" = PI0252_R1_SPEED_MARGIN_TO_FULL_FINETUNE_GO
test "$(jq -er .canonical_issue_comment "$card")" = 5862818190
test "$(jq -er .pointer_pr_comment "$card")" = 5862824588
test "$(jq -er .stage.steps "$card")" = 2000
test "$(jq -er .selected_checkpoint "$card")" = NONE
test "$(jq -er .d1_runtime_id "$card")" = S4
jq -e --arg arm "$arm" '.optimizer.learning_rate == 0.00001 and .optimizer.steps == 2000 and .optimizer.checkpoint_steps == [1000,2000] and .optimizer.weight_decay == 0.00001 and .loss_coefficients.ell_pos == 0.4 and .loss_coefficients.ell_delta == 0.1 and .loss_coefficients.ell_rot == 0.1 and .loss_coefficients.ell_speed_margin == (if $arm == "A" then 0.0 else 0.1 end)' "$card" >/dev/null

repo_code=$(jq -er .paths.repo_code_root "$card")
code=$(jq -er .paths.code_root "$card")
training_runtime=$(jq -er .paths.training_runtime_root "$card")
stage10=$(jq -er .paths.stage10_root "$card")
groot=$(jq -er .paths.groot_source "$card")
output=$(jq -er .paths.output_root "$card")
driver_root=$(jq -er .paths.execution_driver_root "$card")
legacy_root=$(jq -er .paths.legacy_execution_driver_root "$card")
token_file=$(jq -er .archive.token_file "$card")
runner="$driver_root/pi0252_ag_train.py"
ff=/scratch/e1192548/Projects/go2-arx5/archive/stage_runs/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__9243a7880b06ac3984ddf4a1a667b685441ec0f34d6d529fa0f96c3c894e10cf
venv="$stage10/runtime/venv"
test -x "$venv/bin/python" && test -d "$ff/lib"
test -r "$runner" && test -r "$driver_root/pi0251_ce_train.py"
test -r "$driver_root/pi0252_step_rng.py" && test -r "$driver_root/pi0252_speed_margin.py"
test -r "$legacy_root/pi0248_cr_train.py" && test -r "$legacy_root/pi0248_rotation_cpu.py"
test -r "$repo_code/scripts/pi0247_lu_train.py" && test -r "$repo_code/scripts/pi0247_u_rollout_overlay.py"
test -r "$training_runtime/pi0246_gate_pass_train.py" && test -r "$code/scripts/pi0243_checkpoint_persistence.py"
test -s "$token_file"
test ! -e "$output/training"
test "$(jq -er .status "$output/hf_preflight_receipt.json")" = PASS
test "$(jq -er .run_card_sha256 "$output/hf_preflight_receipt.json")" = "$expected"
unset PI0243_DURABLE_ROOT PI0243_DURABLE_HOST PI0243_CHECKPOINT_FAMILY
export PI0243_HF_TOKEN_FILE="$token_file"
export LD_LIBRARY_PATH="$ff/lib:$ff/compat:$venv/lib/python3.12/site-packages/torchcodec:$venv/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$driver_root:$legacy_root:$repo_code/scripts:$repo_code/src:$training_runtime:$code/scripts:$code/src:$groot:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false NO_ALBUMENTATIONS_UPDATE=1
test "$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^$/d' | wc -l)" -eq 1
nvidia-smi --query-gpu=name --format=csv,noheader | grep -qi H200
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader
"$venv/bin/python" -u "$runner" --train --arm "$arm" --run-card "$card"
test "$(jq -er .global_step "$output/training_manifest.json")" = 2000
test "$(jq -er .selected_checkpoint "$output/training_manifest.json")" = NONE
test "$(jq -er .status "$output/pi0252_training_integrity.json")" = "PASS_PI0252_${arm}_TRAINING_INTEGRITY"
