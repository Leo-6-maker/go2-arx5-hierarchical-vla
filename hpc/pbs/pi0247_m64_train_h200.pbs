#!/usr/bin/env bash
#PBS -N pi0247_m64_u
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -m n
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB
#PBS -l walltime=16:00:00
#PBS -o /scratch/e1192548/pi0247_generation_to_sim_20260926/M64_U_5845272077/logs/
#PBS -e /scratch/e1192548/pi0247_generation_to_sim_20260926/M64_U_5845272077/logs/

set -euo pipefail
trap 'rc=$?; echo "PI0247_M64_FAILURE line=${LINENO} status=${rc}" >&2' ERR
card=${PI0247_RUN_CARD:?sealed M64 card is required}
expected=${PI0247_RUN_CARD_SHA256:?run-card SHA256 is required}
test "$(sha256sum "$card" | cut -d ' ' -f 1)" = "$expected"
test "$(jq -er .sha256 "$(dirname "$card")/run_card.seal.json")" = "$expected"
test "$(jq -er .schema "$card")" = PI0247_M64_RUN_CARD_V1
test "$(jq -er .arm "$card")" = U
test "$(jq -er .status "$card")" = SEALED_READY_NOT_STARTED
test "$(jq -er .authorization "$card")" = PI0247_GENERATION_TO_SELECTED_SIM_GO
test "$(jq -er .execution_authorization "$card")" = PI0247_R2_U_AND_PAIRED_VERDICT_GO
test "$(jq -er .canonical_issue_comment "$card")" = 5845272077
test "$(jq -er .d1_runtime_id "$card")" = S4
test "$(jq -er .optimizer.steps "$card")" = 5000
test "$(jq -er .selected_checkpoint "$card")" = NONE
test "$(jq -er .archive.path_prefix "$card")" = arms/PI0247/r2-qualified-U-M64-20260926
jq -e '.optimizer.learning_rate == 0.00001 and .loss_coefficients.ell_pos == 0.1 and .loss_coefficients.ell_delta == 0.1' "$card" >/dev/null

repo_code=$(jq -er .paths.repo_code_root "$card")
code=$(jq -er .paths.code_root "$card")
training_runtime=$(jq -er .paths.training_runtime_root "$card")
p_runtime=$(jq -er .paths.p_runtime_root "$card")
stage10=$(jq -er .paths.stage10_root "$card")
groot=$(jq -er .paths.groot_source "$card")
output=$(jq -er .paths.output_root "$card")
token_file=$(jq -er .archive.token_file "$card")
resume_after=${PI0247_RESUME_AFTER_STEP:-0}
case "$resume_after" in 0|1000|2500) ;; *) exit 2 ;; esac
resume_args=()
if [[ "$resume_after" != 0 ]]; then resume_args=(--resume-after-step "$resume_after"); fi
runner="$repo_code/scripts/pi0247_lu_train.py"
ff=/scratch/e1192548/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__9243a7880b06ac3984ddf4a1a667b685441ec0f34d6d529fa0f96c3c894e10cf
venv="$stage10/runtime/venv"
test "$output" = /scratch/e1192548/pi0247_generation_to_sim_20260926/M64_U_5845272077
test -x "$venv/bin/python" && test -d "$ff/lib"
test -r "$runner" && test -r "$repo_code/hpc/pbs/pi0247_m64_train_h200.pbs"
test -r "$training_runtime/pi0246_gate_pass_train.py" && test -r "$p_runtime/P_runtime_binding.json"
test -s "$token_file"
if [[ "$resume_after" == 0 ]]; then
  test ! -e "$output/training"
else
  test -s "$output/durable_receipts/checkpoint-$resume_after.durable_receipt.json"
  test -s "$output/hf_readbacks/checkpoint-$resume_after.json"
fi
test "$(jq -er .status "$output/hf_preflight_receipt.json")" = PASS
unset PI0243_DURABLE_ROOT PI0243_DURABLE_HOST PI0243_CHECKPOINT_FAMILY
export PI0243_HF_TOKEN_FILE="$token_file"
export LD_LIBRARY_PATH="$ff/lib:$ff/compat:$venv/lib/python3.12/site-packages/torchcodec:$venv/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$repo_code/scripts:$repo_code/src:$training_runtime:$code/scripts:$code/src:$groot:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false NO_ALBUMENTATIONS_UPDATE=1
test "$(nvidia-smi --query-gpu=name --format=csv,noheader | sed '/^$/d' | wc -l)" -eq 1
nvidia-smi --query-gpu=name --format=csv,noheader | grep -qi H200
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader
"$venv/bin/python" -u "$runner" --train --arm U --run-card "$card" "${resume_args[@]}"
test "$(jq -er .global_step "$output/training_manifest.json")" = 5000
test "$(jq -er .selected_checkpoint "$output/training_manifest.json")" = NONE
