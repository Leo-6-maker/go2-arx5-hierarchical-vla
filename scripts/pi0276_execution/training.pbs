#!/usr/bin/env bash
#PBS -N pi0276_task
#PBS -P CFP05-CF-052
#PBS -q auto
#PBS -m n
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=12:00:00
#PBS -o /scratch/e1192548/Projects/go2-arx5/experiments/PI0276/logs/
#PBS -e /scratch/e1192548/Projects/go2-arx5/experiments/PI0276/logs/
set -euo pipefail
source /scratch/e1192548/Projects/go2-arx5/experiments/PI0273/code/environment.sh
root=/scratch/e1192548/Projects/go2-arx5/experiments/PI0276
export PYTHONPATH="$root/code:$PYTHONPATH"
exec 9>"$root/runtime/training.lock"
flock -n 9
if [ ! -f "$root/evidence/HOPPER_CPU_ADMISSION.json" ]; then
    "$venv/bin/python" -u "$root/code/admit_hopper.py" cpu
fi
if [ ! -f "$root/evidence/RUNTIME_BINDING_TASK.json" ]; then
    "$venv/bin/python" -u "$root/code/admit_hopper.py" binding
fi
if [ ! -f "$root/EXECUTION_FILESET.json" ]; then
    "$venv/bin/python" -u "$root/code/admit_hopper.py" seal
fi
"$venv/bin/python" -u "$root/code/train.py" --arm TASK --phase continuous --limit 8
"$venv/bin/python" -u "$root/code/train.py" --arm TASK --phase split --limit 4
"$venv/bin/python" -u "$root/code/train.py" --arm TASK --phase split --limit 8 --resume 4
"$venv/bin/python" -u "$root/code/train.py" --arm TASK --compare
"$venv/bin/python" -u "$root/code/retire_discarded_canary.py"
"$venv/bin/python" -u "$root/code/train.py" --arm TASK --phase main --limit 8192
"$venv/bin/python" -u "$root/code/training_audit.py"
for step in 4096 8192; do
    "$venv/bin/python" -u "$root/code/checkpoint.py" --step "$step"
done
