#!/usr/bin/env bash
#PBS -N pi0261_pair_main
#PBS -P CFP03-CF-004
#PBS -q auto
#PBS -m n
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=06:00:00
#PBS -o /scratch/e1192548/Projects/go2-arx5/experiments/PI0261/logs/
#PBS -e /scratch/e1192548/Projects/go2-arx5/experiments/PI0261/logs/
set -euo pipefail
root=/scratch/e1192548/Projects/go2-arx5/experiments/PI0261
venv=/scratch/e1192548/stage22_h200_runtime_deb920_20260902/runtime/venv
ff=/scratch/e1192548/Projects/go2-arx5/archive/stage_runs/STAGE45B_FFMPEG6_NATIVE_RUNTIME_V1__9243a7880b06ac3984ddf4a1a667b685441ec0f34d6d529fa0f96c3c894e10cf
test "$(sha256sum "$root/code/pi0261_train.py" | cut -d ' ' -f 1)" = "${PI0261_CODE_SHA256:?}"
test "$(sha256sum "$root/PAIRING_PLAN.json" | cut -d ' ' -f 1)" = 208f0bfbc97095369ce84329899bbbde67eb5f694ca8c9022f0566dc61f28477
test "${PI0261_ARM:?}" = C -o "${PI0261_ARM}" = P
test "${PI0261_LIMIT:?}" = 1000 -o "${PI0261_LIMIT}" = 2000
test -f "$root/$PI0261_ARM/canary_compare.json"
export HF_HOME=/scratch/e1192548/stage22_h200_cosmos_v2_20260902/hf_home
export HF_HUB_CACHE="$HF_HOME/hub" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false NO_ALBUMENTATIONS_UPDATE=1 PYTHONUNBUFFERED=1 CUBLAS_WORKSPACE_CONFIG=:4096:8
export LD_LIBRARY_PATH="$ff/lib:$ff/compat:$venv/lib/python3.12/site-packages/torchcodec:$venv/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$root/code:/scratch/e1192548/Projects/go2-arx5/experiments/PI0260/R3/execution:/scratch/e1192548/pi0244_fixed16_10k_v1/scripts:/scratch/e1192548/pi0244_fixed16_10k_v1/src:/scratch/e1192548/pi0247_generation_to_sim_20260926/execution_code_m64_39b3718a0a1e/scripts:/scratch/e1192548/pi0247_generation_to_sim_20260926/execution_code_m64_39b3718a0a1e/src:/scratch/e1192548/stage22_h200_runtime_deb920_20260902/src/isaac-gr00t:${PYTHONPATH:-}"
"$venv/bin/python" -u "$root/code/pi0261_train.py" --arm "$PI0261_ARM" --phase main --limit "$PI0261_LIMIT" --resume "${PI0261_RESUME:-0}"
