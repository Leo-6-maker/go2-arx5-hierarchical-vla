Bootstrap: docker
From: {{ ros_image }}

%setup
    # Site bind roots must exist before %post enters the writable OCI rootfs.
    test -n "${APPTAINER_ROOTFS:-}"
    mkdir -p "$APPTAINER_ROOTFS/app1" "$APPTAINER_ROOTFS/scratch" \
        "$APPTAINER_ROOTFS/cm" "$APPTAINER_ROOTFS/nfs"

%labels
    purpose Vanda-frozen-WBC-build-and-simulation
    controller_source user-selected-archive-not-embedded-in-image

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake git pkg-config python3-dev python3-numpy \
        python3-yaml python3-scipy python3-colcon-common-extensions python3-rosdep \
        python3-venv python3-opengl python3-pil \
        libeigen3-dev libboost-all-dev libtbb-dev libyaml-cpp-dev \
        libglfw3-dev libgl1-mesa-dev libegl1-mesa-dev libgl1-mesa-dri \
        tmux xvfb xauth mesa-utils \
        ros-jazzy-pinocchio ros-jazzy-urdfdom ros-jazzy-kdl-parser \
        ros-jazzy-robot-state-publisher ros-jazzy-rviz2 ros-jazzy-interactive-markers \
        ros-jazzy-tf2-ros ros-jazzy-ament-cmake ros-jazzy-rclcpp \
        ros-jazzy-rclcpp-lifecycle ros-jazzy-rclpy ros-jazzy-nav-msgs \
        ros-jazzy-sensor-msgs ros-jazzy-trajectory-msgs ros-jazzy-std-msgs \
        ros-jazzy-geometry-msgs ros-jazzy-visualization-msgs \
        ros-jazzy-ament-index-python ros-jazzy-launch-ros ros-jazzy-xacro
    mkdir -p /opt/wbc-environment
    python3 -m venv --system-site-packages /opt/wbc-python
    /opt/wbc-python/bin/python -m pip --disable-pip-version-check install \
        --only-binary=:all: --report /opt/wbc-environment/python-packages.json \
        mujoco==3.2.7 Pillow==10.4.0
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
        > /opt/wbc-environment/dpkg.tsv

%environment
    export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
    export PYTHONDONTWRITEBYTECODE=1
    export PATH=/opt/wbc-python/bin:$PATH

%test
    set -eu
    . /opt/ros/jazzy/setup.sh
    /opt/wbc-python/bin/python -c 'import mujoco,rclpy; assert mujoco.__version__ == "3.2.7"'
    cmake --version
    colcon --help >/dev/null
